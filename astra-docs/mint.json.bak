{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Astra",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://astra.dev"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#7C5CFF",
    "light": "#A88BFF",
    "dark": "#5A3FE6",
    "anchors": {
      "from": "#7C5CFF",
      "to": "#A88BFF"
    }
  },
  "topbarLinks": [
    {
      "name": "GitHub",
      "url": "https://github.com/astra-dev/astra"
    }
  ],
  "topbarCtaButton": {
    "type": "github",
    "url": "https://github.com/astra-dev/astra"
  },
  "tabs": [
    {
      "name": "Documentation",
      "url": "/"
    },
    {
      "name": "API Reference",
      "url": "reference"
    },
    {
      "name": "Cookbook",
      "url": "cookbook"
    },
    {
      "name": "Playground",
      "url": "https://github.com/astra-dev/astra/tree/main/astra-playground-ui"
    }
  ],
  "anchors": [
    {
      "name": "Research Paper",
      "icon": "book-open",
      "url": "https://github.com/astra-dev/astra/blob/main/paper/main.pdf"
    },
    {
      "name": "Benchmarks",
      "icon": "chart-line",
      "url": "https://github.com/astra-dev/astra/tree/main/benchmarking"
    },
    {
      "name": "Discord",
      "icon": "discord",
      "url": "https://discord.gg/astra"
    },
    {
      "name": "X / Twitter",
      "icon": "twitter",
      "url": "https://x.com/astra_dev"
    }
  ],
  "navigation": [
    {
      "group": "Get Started",
      "pages": [
        "introduction",
        "quickstart",
        "installation"
      ]
    },
    {
      "group": "Concepts",
      "pages": [
        "concepts/architecture",
        "concepts/why-compile-not-loop",
        "concepts/agents",
        "concepts/teams",
        "concepts/tools",
        "concepts/semantic-layer",
        "concepts/memory-and-storage",
        "concepts/rag",
        "concepts/mcp",
        "concepts/middleware",
        "concepts/observability"
      ]
    },
    {
      "group": "The Compiler",
      "pages": [
        "compiler/dsl-syntax",
        "compiler/ast-validator",
        "compiler/execution-graph",
        "compiler/executor",
        "compiler/replay"
      ]
    },
    {
      "group": "How-to Guides",
      "pages": [
        "guides/first-agent",
        "guides/multi-agent-team",
        "guides/custom-tool",
        "guides/mcp-toolkit",
        "guides/conversational-memory",
