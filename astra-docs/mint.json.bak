  "footerSocials": {
    "github": "https://github.com/astra-dev/astra",
    "x": "https://x.com/astra_dev",
    "discord": "https://discord.gg/astra"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "search": {
    "prompt": "Search Astra docs..."
  },
  "metadata": {
    "og:image": "/images/og/default.png",
    "og:site_name": "Astra Documentation",
    "twitter:card": "summary_large_image"
  },
  "analytics": {
    "plausible": {
      "domain": "docs.astra.dev"
    }
  }
}
