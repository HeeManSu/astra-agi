        "guides/custom-middleware",
        "guides/multi-provider",
        "guides/tracing-and-replay",
        "guides/deploying-to-production"
      ]
    },
    {
      "group": "Runtime",
      "pages": [
        "runtime/astra-server",
        "runtime/rest-endpoints",
        "runtime/sse-streaming",
        "runtime/auth",
        "runtime/registry",
        "runtime/tool-sync",
        "runtime/health-probes"
      ]
    },
    {
