      "pages": [
        "observability/setup",
        "observability/traces-and-spans",
        "observability/metrics",
        "observability/streaming-metrics",
        "observability/querying",
        "observability/integrations"
      ]
    },
    {
      "group": "Comparisons",
      "pages": [
        "comparisons/vs-langgraph",
        "comparisons/vs-crewai",
        "comparisons/vs-agno",
        "comparisons/vs-autogen"
      ]
    },
    {
      "group": "Contributing",
      "pages": [
        "contributing",
        "changelog"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "reference/index"
      ]
    },
    {
      "group": "astra-framework",
      "pages": [
        "reference/framework/index"
      ]
    },
    {
      "group": "astra-runtime",
      "pages": [
        "reference/runtime/index"
      ]
    },
    {
      "group": "astra-observability",
      "pages": [
        "reference/observability/index"
      ]
    },
    {
      "group": "Cookbook",
      "pages": [
        "cookbook/index",
        "cookbook/investment-team",
        "cookbook/market-research",
        "cookbook/enterprise-teams",
        "cookbook/limca"
      ]
